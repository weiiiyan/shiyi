{
  "nodes": [
    {
      "id": "file:code/server/index.js",
      "type": "file",
      "name": "index.js",
      "filePath": "code/server/index.js",
      "summary": "Express server entry point that bootstraps the ShiYiAiChat backend on port 3001, mounting deck, learn, and AI route modules and providing a health-check endpoint with global error handling.",
      "tags": ["entry-point", "server", "express", "middleware"],
      "complexity": "simple"
    },
    {
      "id": "file:code/server/routes/ai.js",
      "type": "file",
      "name": "ai.js",
      "filePath": "code/server/routes/ai.js",
      "summary": "Express router defining AI-related endpoints: POST /test for verifying AI provider connectivity and GET /presets for listing available model presets (Qwen, Doubao, OpenAI).",
      "tags": ["api-handler", "express", "router", "ai"],
      "complexity": "simple"
    },
    {
      "id": "file:code/server/routes/decks.js",
      "type": "file",
      "name": "decks.js",
      "filePath": "code/server/routes/decks.js",
      "summary": "Express router defining deck-related endpoints: GET / for listing ShiYi-branded Anki decks, GET /status for checking Anki-Connect availability, and GET /all as a debug endpoint returning all Anki deck names.",
      "tags": ["api-handler", "express", "router", "anki"],
      "complexity": "simple"
    },
    {
      "id": "file:code/server/routes/learn.js",
      "type": "file",
      "name": "learn.js",
      "filePath": "code/server/routes/learn.js",
      "summary": "Express router implementing the core learning flow with five endpoints: POST /start (begin session, fetch due cards, generate AI scenario), POST /respond (submit user reply for AI judgment), POST /complete (submit score to Anki and advance), POST /next (load next card), and GET /progress (retrieve session stats).",
      "tags": ["api-handler", "express", "router", "learning", "session"],
      "complexity": "complex"
    },
    {
      "id": "file:code/server/services/aiService.js",
      "type": "file",
      "name": "aiService.js",
      "filePath": "code/server/services/aiService.js",
      "summary": "AI multi-model service layer supporting Qwen, Doubao, and OpenAI providers. Generates immersive English-learning scenarios (read/write/listen/speak) and judges user responses with a supportive scoring philosophy. Includes robust JSON extraction from LLM output that recovers from markdown wrapping and malformed responses.",
      "tags": ["service", "ai", "language-learning", "prompt-engineering", "multi-model"],
      "complexity": "complex"
    },
    {
      "id": "file:code/server/services/ankiService.js",
      "type": "file",
      "name": "ankiService.js",
      "filePath": "code/server/services/ankiService.js",
      "summary": "Anki-Connect API service layer that proxies all Anki interactions (deck listing, due card retrieval, vocabulary extraction, answer submission) via localhost:8765. Works around a Windows UTF-8 encoding bug by querying with deck IDs (did:) rather than Chinese deck names.",
      "tags": ["service", "anki", "anki-connect", "proxy", "vocabulary"],
      "complexity": "complex"
    },
    {
      "id": "file:code/server/services/sessionService.js",
      "type": "file",
      "name": "sessionService.js",
      "filePath": "code/server/services/sessionService.js",
      "summary": "In-memory learning session manager using a Map with 2-hour TTL expiry. Tracks current card, conversation history, fail count, completed cards, and score distribution per deck session. Formats AI scenario messages into styled prompts by card type.",
      "tags": ["service", "session", "state-management", "in-memory"],
      "complexity": "moderate",
      "languageNotes": "Uses vanilla Map with setTimeout-based TTL for zero-dependency session expiry, avoiding external cache dependencies."
    },
    {
      "id": "function:code/server/services/aiService.js:parseAIJson",
      "type": "function",
      "name": "parseAIJson",
      "filePath": "code/server/services/aiService.js",
      "lineRange": [24, 89],
      "summary": "Robustly extracts a JSON object from raw LLM output by trying three strategies in order: stripping markdown code fences, bracket-pair matching for the first complete JSON object, and a final fallback parse with detailed error reporting.",
      "tags": ["utility", "json-parsing", "error-handling", "llm-output"],
      "complexity": "moderate"
    },
    {
      "id": "function:code/server/services/aiService.js:createClient",
      "type": "function",
      "name": "createClient",
      "filePath": "code/server/services/aiService.js",
      "lineRange": [122, 134],
      "summary": "Creates an OpenAI-compatible client instance by resolving provider presets for baseURL and model, validating that an API key is present.",
      "tags": ["factory", "ai-client", "openai-compatible"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/aiService.js:generateScenario",
      "type": "function",
      "name": "generateScenario",
      "filePath": "code/server/services/aiService.js",
      "lineRange": [147, 258],
      "summary": "Generates an immersive English-learning scenario tailored to card type (read/write/listen/speak) using the configured AI model. Crafts a system prompt enforcing English-only immersion, constrained vocabulary, and meaningful comprehension questions. Returns structured JSON with scenario text, task/question, and optional hints.",
      "tags": ["ai-generation", "prompt-engineering", "language-learning", "scenario"],
      "complexity": "complex",
      "languageNotes": "Uses card-type-specific prompt templates with response_format: json_object and high temperature (0.9) for creative scenario generation."
    },
    {
      "id": "function:code/server/services/aiService.js:judgeResponse",
      "type": "function",
      "name": "judgeResponse",
      "filePath": "code/server/services/aiService.js",
      "lineRange": [274, 346],
      "summary": "Evaluates a student's response against the target word's meaning using AI judgment. Applies a lenient scoring philosophy (communication over grammar), condenses recent conversation history to the last 4 exchanges, and adapts leniency when the student has repeated failures.",
      "tags": ["ai-judgment", "scoring", "language-learning", "assessment"],
      "complexity": "moderate"
    },
    {
      "id": "function:code/server/services/aiService.js:testConnection",
      "type": "function",
      "name": "testConnection",
      "filePath": "code/server/services/aiService.js",
      "lineRange": [351, 363],
      "summary": "Tests connectivity to the configured AI provider by sending a trivial chat completion request and returning success status with a response preview or error message.",
      "tags": ["ai", "connectivity-test", "diagnostic"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/ankiService.js:invoke",
      "type": "function",
      "name": "invoke",
      "filePath": "code/server/services/ankiService.js",
      "lineRange": [12, 26],
      "summary": "Low-level Anki-Connect API caller that sends POST requests to localhost:8765 with Anki-Connect protocol version 6, parses the JSON response, and throws on error results.",
      "tags": ["api-client", "anki-connect", "http", "proxy"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/ankiService.js:getShiYiDecks",
      "type": "function",
      "name": "getShiYiDecks",
      "filePath": "code/server/services/ankiService.js",
      "lineRange": [54, 120],
      "summary": "Retrieves all ShiYi-branded Anki decks (ShiYi:: prefix) with per-deck statistics. Builds deck ID mappings to query via did: for UTF-8 compatibility, then collects total and due card counts for each ShiYi deck.",
      "tags": ["anki", "deck-management", "stats", "api-handler"],
      "complexity": "moderate"
    },
    {
      "id": "function:code/server/services/ankiService.js:getDueCards",
      "type": "function",
      "name": "getDueCards",
      "filePath": "code/server/services/ankiService.js",
      "lineRange": [128, 182],
      "summary": "Fetches all due cards for a given deck by querying with deck ID, then hydrates full card info by joining cardsInfo, cardsToNotes, and notesInfo responses. Extracts word, concept, card type, examples, and context from Anki note fields.",
      "tags": ["anki", "card-retrieval", "data-hydration", "api-handler"],
      "complexity": "complex",
      "languageNotes": "Performs a three-step Anki-Connect join (cardsInfo + cardsToNotes + notesInfo) to hydrate card data with note fields, avoiding multiple round-trips per card."
    },
    {
      "id": "function:code/server/services/ankiService.js:getKnownVocabulary",
      "type": "function",
      "name": "getKnownVocabulary",
      "filePath": "code/server/services/ankiService.js",
      "lineRange": [188, 216],
      "summary": "Extracts all word-concept pairs from a deck's notes to build a known-vocabulary list. Uses a Set with JSON stringification for deduplication, then maps back to objects for the AI service to constrain scenario generation.",
      "tags": ["anki", "vocabulary", "data-extraction", "deduplication"],
      "complexity": "moderate"
    },
    {
      "id": "function:code/server/services/sessionService.js:createSession",
      "type": "function",
      "name": "createSession",
      "filePath": "code/server/services/sessionService.js",
      "lineRange": [16, 41],
      "summary": "Creates or resets a learning session for a deck, clearing any existing timer. Initializes session state with empty history, zero fail count, and a 2-hour auto-expiry timer.",
      "tags": ["session", "initialization", "state-management"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/sessionService.js:getSession",
      "type": "function",
      "name": "getSession",
      "filePath": "code/server/services/sessionService.js",
      "lineRange": [43, 53],
      "summary": "Retrieves an active session by deck ID and refreshes its expiry timer on each access to keep the session alive during active learning.",
      "tags": ["session", "retrieval", "ttl-refresh"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/sessionService.js:deleteSession",
      "type": "function",
      "name": "deleteSession",
      "filePath": "code/server/services/sessionService.js",
      "lineRange": [55, 61],
      "summary": "Explicitly removes a session and clears its expiry timer, used when a learning session is manually terminated.",
      "tags": ["session", "cleanup", "state-management"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/sessionService.js:setCurrentCard",
      "type": "function",
      "name": "setCurrentCard",
      "filePath": "code/server/services/sessionService.js",
      "lineRange": [63, 79],
      "summary": "Sets the active card and AI-generated scenario for a session, resets conversation history and fail count, and pushes the formatted scenario message as the first assistant message in history.",
      "tags": ["session", "card-management", "scenario"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/sessionService.js:recordScore",
      "type": "function",
      "name": "recordScore",
      "filePath": "code/server/services/sessionService.js",
      "lineRange": [88, 102],
      "summary": "Records the ease score (1=again, 3=good, 4=easy) for the current card, updating the score distribution counters and tracking consecutive failures via the failCount field.",
      "tags": ["session", "scoring", "tracking"],
      "complexity": "simple"
    },
    {
      "id": "function:code/server/services/sessionService.js:getProgress",
      "type": "function",
      "name": "getProgress",
      "filePath": "code/server/services/sessionService.js",
      "lineRange": [111, 121],
      "summary": "Returns a snapshot of learning progress including completed card count, score distribution, current fail count, and session start time.",
      "tags": ["session", "progress", "reporting"],
      "complexity": "simple"
    }
  ],
